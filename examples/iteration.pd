# English collection iteration
let total = 0
for number in range(1, 6) {
  total = total + number
}
print "total: {total}"

let profile = {"name": "Rafi", "class": 6}
for key in profile {
  print "field: {key}"
}

# বাংলা iteration
ধরি যোগফল = ০
প্রতি মান মধ্যে পরিসর(৩) {
  যোগফল = যোগফল + মান
}
দেখাও "বাংলা যোগফল: {যোগফল}"

ধরি routes = [{"method": "GET", "path": "/students", "status": 200, "body": {"ok": true, "items": ["Rafi", "Mitu"]}}, {"method": "GET", "path": "/products", "status": 200, "body": {"ok": true, "items": [{"name": "খাতা", "price": 50}]}}]

ধরি studentRequest = {"method": "GET", "path": "/students"}

{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Padma",
  "scopeName": "source.padma",
  "patterns": [
    { "include": "#comments" },
    { "include": "#strings" },
    { "include": "#keywords" },
    { "include": "#constants" },
    { "include": "#numbers" },
    { "include": "#functions" }
  ],
  "repository": {
    "comments": { "patterns": [{ "name": "comment.line.number-sign.padma", "match": "#.*$" }] },
    "strings": { "patterns": [{ "name": "string.quoted.double.padma", "begin": "\"", "end": "\"", "patterns": [{ "name": "constant.character.escape.padma", "match": "\\\\." }] }] },
    "keywords": { "patterns": [{ "name": "keyword.control.padma", "match": "\\b(let|print|if|else|while|for|in|function|fn|return|import|export|as)\\b|(?<![\\p{L}\\p{N}_])(ধরি|দেখাও|যদি|নইলে|যতক্ষণ|প্রতি|মধ্যে|ফাংশন|ফেরত|ইমপোর্ট|রপ্তানি|হিসেবে)(?![\\p{L}\\p{N}_])" }] },
    "constants": { "patterns": [{ "name": "constant.language.padma", "match": "\\b(true|false|none)\\b|(?<![\\p{L}\\p{N}_])(সত্য|মিথ্যা|কিছুইনা)(?![\\p{L}\\p{N}_])" }] },
    "numbers": { "patterns": [{ "name": "constant.numeric.padma", "match": "\\b[0-9]+(?:\\.[0-9]+)?\\b|[০-৯]+(?:\\.[০-৯]+)?" }] },
    "functions": { "patterns": [{ "name": "entity.name.function.padma", "match": "(?<=\\b(function|fn)\\s+)[A-Za-z_\\u0980-\\u09FF][A-Za-z0-9_\\u0980-\\u09FF]*|(?<=ফাংশন\\s+)[A-Za-z_\\u0980-\\u09FF][A-Za-z0-9_\\u0980-\\u09FF]*" }] }
  }
}
